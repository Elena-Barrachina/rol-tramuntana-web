# Keep the real values in .env.local. Do not commit that file.
GMAIL_USER=roltramuntana@gmail.com
# Create this 16-character App Password in the Google Account security settings.
GMAIL_APP_PASSWORD=replace_with_your_app_password

# Comma-separated IDs of the public Google Calendars shown on /activitats.
# Example: association@example.com,abc123@group.calendar.google.com
NEXT_PUBLIC_GOOGLE_CALENDAR_IDS=calendar-one@group.calendar.google.com,calendar-two@group.calendar.google.com
